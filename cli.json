{
  "$schema": "https://opencode.ai/v2/cli.json",
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "prompt": {
    "editor": true,
    "paste": "full",
    "image_preview": false
  },
  "theme": {
    "name": "kaapi",
    "mode": "dark"
  },
  "session": {
    "thinking": "hide",
    "grouping": "auto",
    "markdown": "rendered"
  }
}
