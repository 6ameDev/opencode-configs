{
  "$schema": "https://opencode.ai/config.json",

  "update": "auto",
  "default_agent": "plan",

  "experimental": {
    "todo": true
  },

  // Preserve V1 outside-project prompt (V2 defaults external_directory to allow)
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  // === Agent Overrides ===
  "agents": {
    "build": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" }
      ]
    }
  },

  // === Auto Compaction (1M Context Window Models) ===
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 40000
    },
    "buffer": "30%"
  },

  "mcp": {
    "servers": {
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@latest",
          "https://aws-mcp.ap-southeast-2.api.aws/mcp",
          "--metadata",
          "AWS_REGION=ap-southeast-2"
        ],
        "pool": true,
        "disabled": true
      }
    }
  }
}
